<?xml version="1.0" encoding="utf-8"?>
<!-- Widget disegnato come immagine (stile calendario Samsung) + zona trasparente in alto a destra per «Nuovo evento» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="56dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/widget_new_event" />
</FrameLayout>
